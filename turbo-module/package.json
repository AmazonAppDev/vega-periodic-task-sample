{
  "name": "@amazon-devices/periodic-task-scheduler",
  "version": "0.0.1",
  "license": "MIT-0",
  "engines": {
    "node": ">=22.14"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "react-native.config.js",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "kepler-codegen": "keplerscript-turbomodule-api codegen src/turbo-modules/PeriodicTaskScheduler.ts -o kepler/turbo-modules/ --new -s PeriodicTaskSchedulerTurboModule && npm-run-all clean-codegen-backups",
    "clean-codegen-backups": "rm -rf kepler/turbo-modules/PeriodicTaskScheduler.cpp.bak kepler/turbo-modules/PeriodicTaskScheduler.h.bak",
    "test": "jest --colors",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "build:js": "tsc -p tsconfig.json",
    "prepare": "npm-run-all build",
    "build:native:debug": "if command -v vega >/dev/null 2>&1; then vega build -b Debug; else kepler build -b Debug; fi",
    "build:native:release": "if command -v vega >/dev/null 2>&1; then vega build -b Release; else kepler build -b Release; fi",
    "build": "npm-run-all build:js build:native:release",
    "build:debug": "npm-run-all build:js build:native:debug",
    "prepack": "npm-run-all build"
  },
  "dependencies": {
    "@amazon-devices/keplerscript-turbomodule-api": "^1.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "turbomodule",
    "targets": [
      "tv"
    ]
  }
}
